# Copy to .env (never commit .env). Everything here is optional.

# Where models are cached. Point at an external drive or a shared folder if you like.
# HF_HOME=/Users/you/Open Source Models/huggingface

# Summarizer: any mlx-lm compatible model (HF repo id or local path).
# LLM_MODEL=mlx-community/Qwen3.5-9B-MLX-4bit

# two_pass (chunked extract → synthesize, best for long videos) | single_pass
# SUMMARY_MODE=two_pass

# Whisper: small (fast) | medium | turbo (large-v3-turbo, most accurate)
# WHISPER_MODEL=small

# Tuning
# CHUNK_TOKENS=7000
# EXTRACT_MAX_TOKENS=2500
# SYNTH_MAX_TOKENS=3000

# YouTube 403 escape hatch (chrome | safari | firefox | edge | brave)
# YTDLP_COOKIES_FROM_BROWSER=chrome
