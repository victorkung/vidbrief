# Copy to .env (never commit .env). Everything here is optional.

# Where models are cached. Point at an external drive or a shared folder if you like.
# HF_HOME=/Users/you/Open Source Models/huggingface

# Summarizer: any mlx-lm compatible model (HF repo id or local path).
# LLM_MODEL=mlx-community/Qwen3.5-9B-MLX-4bit

# chaptered (condense → plan chapters → write chapters → summary; best quality) | single_pass
# SUMMARY_MODE=chaptered

# Transcript: auto (YouTube captions when available, else Whisper) | whisper (always) | captions (never Whisper)
# TRANSCRIPT_SOURCE=auto

# Whisper runs only for X videos and YouTube videos without captions.
# turbo (default, most accurate, ~1.6 GB) | small (faster, ~0.5 GB, more misheard names)
# WHISPER_MODEL=turbo

# Tuning
# CHUNK_TOKENS=7000
# CONDENSE_MAX_TOKENS=2000
# CHAPTER_MAX_TOKENS=700

# YouTube 403 escape hatch (chrome | safari | firefox | edge | brave)
# YTDLP_COOKIES_FROM_BROWSER=chrome
